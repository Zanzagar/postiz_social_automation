    # CI, on a pull request: its title and description, which a squash merge
    # (repository setting "Pull request title and description") makes the
    # squashed commit's message, checked against <rev>'s tree (the merge result).
    [ $# -eq 3 ] || die "usage: check-trailers --pr-message <file: title, blank line, description> <rev>"
    [ -r "$2" ] || die "cannot read $2"
    need_commit "$3"
    make_tmpd
    clean=$TMPD/message
    tr -d '\r' < "$2" > "$clean"          # GitHub stores descriptions with CRLF
    short=$(git rev-parse --short "$3")
    check_message "$clean" "$(git rev-parse "$3"):" "the pull request's tree ($short)" \
      "the pull request description (a squash merge's commit message)" || exit 1
    echo "grill-gate: the pull request description carries a trailer that holds."
    exit 0
    ;;
  --anchors) anchors_awk anchors; exit ;;
  --slug) anchors_awk slug; exit ;;
esac

make_tmpd
BASELINE_EXCL=''
while :; do
  case "${1:-}" in
    --baseline)
      # Branch tips recorded when the project adopted the gate: everything
      # reachable from one is pre-gate history, whatever its date. A tip this
      # clone does not have grandfathers nothing and is not an error.
      [ $# -ge 2 ] && [ -r "$2" ] || die "usage: --baseline <file of commit ids> (cannot read ${2:-nothing})"
      total=0 have=0
      for sha in $(sed 's/#.*//' "$2" | tr -d '\r'); do
        total=$((total + 1))
        case $sha in *[!0-9a-f]*) die "--baseline $2: \"$sha\" is not a commit id" ;; esac
        if git rev-parse -q --verify "$sha^{commit}" > /dev/null; then
          have=$((have + 1)); BASELINE_EXCL="$BASELINE_EXCL ^$sha"
        fi
      done
      echo "grill-gate: baseline: $have of $total tips are in this clone; their history is pre-gate."
      shift 2
      ;;
    *) break ;;
  esac
done

case "${1:-}" in
  --commit)
    [ $# -eq 2 ] || die "usage: check-trailers --commit <rev>"
    need_commit "$2"
    check_range --no-walk "$2" || exit 1
    ;;
  --pr)
    [ $# -eq 3 ] || die "usage: check-trailers --pr <base> <head>"
    need_commit "$2"; need_commit "$3"
    check_range "$3" "^$2" || exit 1
    ;;
  --push)
    # <default-ref> is given for a push to any OTHER branch: what the default
    # branch already has was checked on its way there. A push TO the default
    # branch gives none: a squash merge writes a new commit there that no pull
    # request run ever saw.
    [ $# -eq 3 ] || [ $# -eq 4 ] || die "usage: check-trailers --push <before> <after> [<default-ref>]"
    before=$2 after=$3 default=${4:-}
    if is_zero "$after"; then echo "grill-gate: the branch was deleted; nothing to check."; exit 0; fi
    need_commit "$after"
    [ -z "$default" ] || need_commit "$default"
    if is_zero "$before" || ! git rev-parse -q --verify "$before^{commit}" > /dev/null; then
      is_zero "$before" && what="a new branch" || what="$before is not in this clone (a force-push?)"
      if [ -n "$default" ]; then
        echo "grill-gate: $what: checking the commits not on $default."
        check_range "$after" "^$default" || exit 1
      else
        echo "grill-gate: $what: checking every commit reachable from the push."
        check_range "$after" || exit 1
      fi
    elif [ -n "$default" ]; then
      check_range "$after" "^$before" "^$default" || exit 1
    else
      check_range "$after" "^$before" || exit 1
    fi
    ;;
  *)
    die "usage: check-trailers --message-file <file> | --pr-message <file> <rev> | [--baseline <file>] (--commit <rev> | --pr <base> <head> | --push <before> <after> [<default-ref>]) | --anchors | --slug"
    ;;
esac
