# ---------------------------------------------------------------------------
# Decided: <path>#<anchor>, resolved in a tree: $2 = ":" (the index being
# committed; git honours GIT_INDEX_FILE, so `git commit -a` works) or "<sha>:".
# $3 = where that is, for the refusal.
# ---------------------------------------------------------------------------
check_decided() {
  v=$1 at=$2 where=$3
  shape="Decided: $v must be <repo-relative-path>#<anchor>, e.g. Decided: docs/design/battle-ui.md#decided-hud-2026-09-24"
  case $v in *'#'*) ;; *) problem "$shape"; return ;; esac
  path=${v%%#*} anchor=${v#*#}
  case $path in ''|/*) problem "$shape"; return ;; esac
  case $anchor in ''|*'#'*|*' '*|*'	'*) problem "$shape"; return ;; esac
  typ=$(git cat-file -t "$at$path" 2>/dev/null) || typ=''
  # The index holds files, not directories: a path with files under it is one.
  [ -z "$typ" ] && [ "$at" = ":" ] && [ -n "$(git ls-files -- "$path" | head -n 1)" ] && typ=tree
  if [ -z "$typ" ]; then
    if [ "$at" = ":" ]; then remedy="Stage it (git add $path) or correct the path."
    else remedy="Correct the path; the decision record must be in the commit's own tree."; fi
    problem "Decided: $v: $path is not in $where. $remedy"
    return
  fi
  if [ "$typ" != blob ]; then
    [ "$typ" = tree ] && typ=directory
    problem "Decided: $v: $path is a $typ in $where, not a file."
    return
  fi
  if ! git cat-file blob "$at$path" | anchors_awk anchors | grep -Fqx -- "$anchor"; then
    problem "Decided: $v: $path has no <a id=\"$anchor\"> and no heading whose GitHub slug is \"$anchor\"."
    problem "  Point at an existing section, or put <a id=\"$anchor\"></a> on its own line above it."
  fi
}

# Git's own revert message: subject `Revert "<subject>"` AND a body line
# `This reverts commit <hex>` (plain or --reference form). Both, so a look-alike
# subject cannot walk past the gate.
is_git_revert() {
  awk 'NR == 1 { if ($0 !~ /^Revert ".*"$/) { bad = 1; exit } next }
       /^This reverts commit [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ { found = 1 }
       END { exit (bad || !found) }' "$1"
}

# Lines that look like gate trailers but sit outside the final trailer block.
misplaced() {
  awk '{ sub(/\r$/, "") } tolower($0) ~ /^(decided|fix|docs|chore|test)[ \t]*:/ { print }' "$1"
}

# $1 = file holding a clean message; $2/$3 as check_decided; $4 = what to call it.
check_message() {
  msg=$1 at=$2 where=$3 what=$4
  found=0
  PROBLEMS=''
  tr_out=$(trailers < "$msg") || die "git interpret-trailers failed"
  tab=$(printf '\t')
  while IFS="$tab" read -r key val; do
    [ -n "$key" ] || continue
    case " $GATE_KEYS " in *" $key "*) ;; *) continue ;; esac
    found=1
    case $key in
      decided) check_decided "$val" "$at" "$where" ;;
      *) [ -n "$val" ] || problem "$(label "$key"): is empty. Say why, e.g. $(label "$key"): <what this commit does and why>" ;;
    esac
  done <<EOF
$tr_out
EOF
  if [ "$found" -eq 0 ]; then
    refuse_missing "$what"
    misplaced "$msg" | while IFS= read -r line; do
      say "  \"$line\" is not in the trailer block. Move it into the LAST paragraph,"
      say "  with no blank line between it and Co-Authored-By, and nothing but \"Key: value\" lines there."
    done
    return 1
  fi
  if [ -n "$PROBLEMS" ]; then
    say "grill-gate: REFUSED: $what has a gate trailer that does not hold:"
    printf '%s' "$PROBLEMS" >&2
    return 1
  fi
  return 0
}

