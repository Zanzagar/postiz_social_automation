# ---------------------------------------------------------------------------
# CI: check a list of commits, each against its own tree.
# ---------------------------------------------------------------------------

# History written before a project adopted the gate is exempt ONLY by
# identity: commits reachable from a tip recorded in .githooks/grill-gate.baseline.
# No date exempts anything (the owner's decision, 2026-09-24): an amend, a
# rebase or a cherry-pick of an old commit is a new commit and needs a trailer.

is_zero() { case $1 in '' | *[!0]*) return 1 ;; *) return 0 ;; esac; }

N_OK=0 N_BAD=0 N_MERGE=0 N_REVERT=0

# fd 3: "sha parent..." lines, oldest first (not stdin, which the
# git commands inside the loop must not be able to swallow).
check_commits() {
  msgf=$TMPD/message
  while read -r sha parents <&3; do
    [ -n "$sha" ] || continue
    short=$(git rev-parse --short "$sha")
    case $parents in *' '*)
      echo "exempt $short merge"; N_MERGE=$((N_MERGE + 1)); continue ;;
    esac
    git show -s --format=%B "$sha" > "$msgf" || die "cannot read commit $sha"
    if is_git_revert "$msgf"; then echo "exempt $short revert"; N_REVERT=$((N_REVERT + 1)); continue; fi
    subject=$(git show -s --format=%s "$sha")
    if check_message "$msgf" "$sha:" "commit $short's tree" "commit $short ($subject)"; then
      echo "ok $short $subject"; N_OK=$((N_OK + 1))
    else
      echo "REFUSED $short $subject"; N_BAD=$((N_BAD + 1))
      [ "${GITHUB_ACTIONS:-}" = true ] &&
        echo "::error title=grill-gate::$short $subject: needs a Decided: or class trailer (Fix:, Docs:, Chore:, Test:) that holds"
    fi
  done
}

# $@ = rev-list arguments naming the commits to check.
check_range() {
  list=$TMPD/commits
  # shellcheck disable=SC2086  # BASELINE_EXCL holds hex ids only, one word each
  git log --reverse --format='%H %P' "$@" $BASELINE_EXCL -- > "$list" || die "git log $* failed"
  check_commits 3< "$list"
  echo "grill-gate: $((N_OK + N_BAD)) commit(s) checked, $N_BAD refused; exempt: $N_MERGE merge, $N_REVERT revert."
  [ "$N_BAD" -eq 0 ]
}

need_commit() {
  git rev-parse -q --verify "$1^{commit}" > /dev/null ||
    die "$1 is not a commit in this clone. In CI, actions/checkout needs fetch-depth: 0."
}

