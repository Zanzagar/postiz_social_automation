# Postiz Configuration
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
IS_GENERAL=true

# Database (passwords should match docker-compose.yaml env vars)
POSTIZ_DB_PASSWORD=CHANGE_ME_postiz_db_password
TEMPORAL_DB_PASSWORD=CHANGE_ME_temporal_db_password
DATABASE_URL=postgresql://postiz-user:${POSTIZ_DB_PASSWORD}@postiz-postgres:5432/postiz-db-local

# Redis
REDIS_URL=redis://postiz-redis:6379

# Internal backend URL (container-internal)
BACKEND_INTERNAL_URL=http://localhost:3000

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# Social Media API Keys (configure in Postiz dashboard after setup)
# Facebook / Instagram (via Facebook)
#X_API_KEY=
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=

# TikTok
#TIKTOK_CLIENT_ID=
#TIKTOK_CLIENT_SECRET=

# --- Content Engine ---

# Postiz Public API (get from Settings > Public API in Postiz dashboard)
POSTIZ_API_KEY=your-api-key-here
POSTIZ_API_URL=https://postiz.sethpc.xyz/api/public/v1

# Google Sheets
GOOGLE_CREDENTIALS_PATH=/path/to/service-account.json
SPREADSHEET_ID=your-spreadsheet-id

# Streamlit
STREAMLIT_PASSWORD=your-secure-password

# n8n (separate host)
N8N_URL=https://n8n.sethpc.xyz
